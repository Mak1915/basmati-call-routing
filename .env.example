# Copy this file to .env and fill it in.

PORT=3000

# The public https address of this server, with no slash at the end.
# Twilio must be able to reach it. Needed to verify that webhooks really come from Twilio.
PUBLIC_URL=

# From the Twilio console (Account > API keys & tokens).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Login for the dashboard. Set a password before putting this online.
DASHBOARD_USER=clinic
DASHBOARD_PASSWORD=

# 1 = show the "Run a test call" button on the dashboard (no real phone call is made).
TEST_CALLS=1
