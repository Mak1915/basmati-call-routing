# Copy this file to .env and fill it in.

PORT=3000

# The public https address of this server, with no slash at the end.
# Twilio must be able to reach it. Needed to verify that webhooks really come from Twilio.
PUBLIC_URL=

# From the Twilio console (Account > API keys & tokens).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Login for the dashboard. Set a password before putting this online.
DASHBOARD_USER=clinic
DASHBOARD_PASSWORD=

# 1 = show the "Run a test call" button on the dashboard (no real phone call is made).
TEST_CALLS=1

# --- Transcription and booking detection (Google Gemini) ---
# Key from https://aistudio.google.com/apikey . Free tier: demo only, never real patient calls.
GEMINI_API_KEY=
# Optional model overrides
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_MODEL=gemini-3.8-flash

# --- Google Sheet (see apps-script/Code.gs) ---
SHEET_WEBHOOK_URL=
SHEET_SECRET=
SHEET_URL=

# --- WhatsApp (Twilio sandbox for the demo) ---
TWILIO_WHATSAPP_FROM=+14155238886
# Clinic rep who gets every booking notice
CLINIC_REP_WHATSAPP=
# Demo only: send the "patient" messages to this number instead of the real caller
DEMO_CUSTOMER_WHATSAPP=

# Reminders for tomorrow's bookings, sent automatically at this hour (Saudi time)
AUTO_REMINDERS=1
# (hour is set by "reminderHour" in config.json, default 17)

# Optional: keep real staff numbers out of GitHub, as JSON: [{"name":"..","number":"+966.."}, ...]
USERS_JSON=
